# Build the schema.
type Query {
    article(slug: String!): Article @deprecated(reason: "GraphQL API is deprecated; use REST GET /articles/{slug}")
    articles(
        first: Int,
        after: String,
        last: Int,
        before: String,
        authoredBy: String
        favoritedBy: String
        withTag: String
    ): ArticlesConnection @deprecated(reason: "GraphQL API is deprecated; use REST GET /articles")
    me: User @deprecated(reason: "GraphQL API is deprecated; use REST GET /user")
    feed(first: Int, after: String, last: Int, before: String): ArticlesConnection @deprecated(reason: "GraphQL API is deprecated; use REST GET /articles/feed")
    profile(username: String!): ProfilePayload @deprecated(reason: "GraphQL API is deprecated; use REST GET /profiles/{username}")
    tags: [String] @deprecated(reason: "GraphQL API is deprecated; use REST GET /tags")
}

union UserResult = UserPayload | Error

type Mutation {
    ### User & Profile
    createUser(input: CreateUserInput): UserResult @deprecated(reason: "GraphQL API is deprecated; use REST POST /users")
    login(password: String!, email: String!): UserPayload @deprecated(reason: "GraphQL API is deprecated; use REST POST /users/login")
    updateUser(changes: UpdateUserInput!): UserPayload @deprecated(reason: "GraphQL API is deprecated; use REST PUT /user")
    followUser(username: String!): ProfilePayload @deprecated(reason: "GraphQL API is deprecated; use REST POST /profiles/{username}/follow")
    unfollowUser(username: String!): ProfilePayload @deprecated(reason: "GraphQL API is deprecated; use REST DELETE /profiles/{username}/follow")

    ### Article
    createArticle(input: CreateArticleInput!): ArticlePayload @deprecated(reason: "GraphQL API is deprecated; use REST POST /articles")
    updateArticle(slug: String!, changes: UpdateArticleInput!): ArticlePayload @deprecated(reason: "GraphQL API is deprecated; use REST PUT /articles/{slug}")
    favoriteArticle(slug: String!): ArticlePayload @deprecated(reason: "GraphQL API is deprecated; use REST POST /articles/{slug}/favorite")
    unfavoriteArticle(slug: String!): ArticlePayload @deprecated(reason: "GraphQL API is deprecated; use REST DELETE /articles/{slug}/favorite")
    deleteArticle(slug: String!): DeletionStatus @deprecated(reason: "GraphQL API is deprecated; use REST DELETE /articles/{slug}")

    ### Comment
    addComment(slug: String!, body: String!): CommentPayload @deprecated(reason: "GraphQL API is deprecated; use REST POST /articles/{slug}/comments")
    deleteComment(slug: String!, id: ID!): DeletionStatus @deprecated(reason: "GraphQL API is deprecated; use REST DELETE /articles/{slug}/comments/{id}")
}

schema {
    query: Query
    mutation: Mutation
}

### Articles
type Article {
    author: Profile!
    body: String!
    comments(first: Int, after: String, last: Int, before: String): CommentsConnection
    createdAt: String!
    description: String!
    favorited: Boolean!
    favoritesCount: Int!
    slug: String!
    tagList: [String],
    title: String!
    updatedAt: String!
}

type ArticleEdge {
    cursor: String!
    node: Article
}

type ArticlesConnection {
    edges: [ArticleEdge]
    pageInfo: PageInfo!
}

### Comments
type Comment {
    id: ID!
    author: Profile!
    article: Article!
    body: String!
    createdAt: String!
    updatedAt: String!
}

type CommentEdge {
    cursor: String!
    node: Comment
}

type CommentsConnection {
    edges: [CommentEdge]
    pageInfo: PageInfo!
}

type DeletionStatus {
    success: Boolean!
}

type PageInfo {
    endCursor: String
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
}

### Profile
type Profile {
    username: String!
    bio: String
    following: Boolean!
    image: String
    articles(first: Int, after: String, last: Int, before: String): ArticlesConnection
    favorites(first: Int, after: String, last: Int, before: String): ArticlesConnection
    feed(first: Int, after: String, last: Int, before: String): ArticlesConnection
}

### User
type User {
    email: String!
    profile: Profile!
    token: String!
    username: String!
}

### Error
type Error {
    message: String
    errors: [ErrorItem!]
}

type ErrorItem {
    key: String!
    value: [String!]!
}

## Mutations

# Input types.
input UpdateArticleInput {
    body: String
    description: String
    title: String
}

input CreateArticleInput {
    body: String!
    description: String!
    tagList: [String]
    title: String!
}

type ArticlePayload {
    article: Article
}

type CommentPayload {
    comment: Comment
}

input CreateUserInput {
    email: String!
    username: String!
    password: String!
}

input UpdateUserInput {
    email: String
    username: String
    password: String
    image: String
    bio: String
}

type UserPayload {
    user: User
}

type ProfilePayload {
    profile: Profile
}
